{
  "hooks": {
    "PreToolUse": [
      {"matcher": "*", "hooks": [{"type": "command", "command": "python3", "args": ["-I", "-S", "${CLAUDE_PLUGIN_ROOT}/core/gate/ifs-pretool.py", "--skills-dir", "${CLAUDE_PLUGIN_ROOT}/skills"], "onFailure": "block"}]}
    ],
    "UserPromptSubmit": [
      {"hooks": [{"type": "command", "command": "python3 -I \"$CLAUDE_PLUGIN_ROOT/core/gate/spec-approval-gate.py\" record --skills-dir \"$CLAUDE_PLUGIN_ROOT/skills\""}]}
    ],
    "SessionStart": [
      {"matcher": "startup", "hooks": [{"type": "command", "command": "python3 -I \"$CLAUDE_PLUGIN_ROOT/core/deps/session-notice.py\"", "timeout": 10}]}
    ],
    "PostToolUse": [
      {"matcher": "Write|Edit|MultiEdit", "hooks": [{"type": "command", "command": "python3 -I \"$CLAUDE_PLUGIN_ROOT/core/gate/spec-approval-gate.py\" plan-changed --skills-dir \"$CLAUDE_PLUGIN_ROOT/skills\""}]}
    ]
  }
}
